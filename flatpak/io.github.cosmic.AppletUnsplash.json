{
    "id": "io.github.cosmic.AppletUnsplash",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "cosmic-applet-unsplash",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--share=network",
        "--device=dri",
        "--talk-name=com.system76.CosmicSettingsDaemon",
        "--filesystem=xdg-config/cosmic:rw"
    ],
    "modules": [
        {
            "name": "cosmic-applet-unsplash",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin",
                "build-args": [
                    "--share=network"
                ],
                "env": {
                    "CARGO_HOME": "/run/build/cosmic-applet-unsplash/cargo"
                }
            },
            "build-commands": [
                "if [ -d vendor ]; then cargo build --offline --release; else cargo build --release; fi",
                "install -Dm0755 target/release/cosmic-applet-unsplash ${FLATPAK_DEST}/bin/cosmic-applet-unsplash",
                "install -Dm0644 resources/io.github.cosmic.AppletUnsplash.desktop ${FLATPAK_DEST}/share/applications/io.github.cosmic.AppletUnsplash.desktop",
                "install -Dm0644 resources/io.github.cosmic.AppletUnsplash.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.cosmic.AppletUnsplash.metainfo.xml",
                "install -Dm0644 resources/icons/hicolor/scalable/apps/io.github.cosmic.AppletUnsplash.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.cosmic.AppletUnsplash.svg",
                "install -Dm0644 resources/icons/hicolor/scalable/apps/io.github.cosmic.AppletUnsplash-symbolic.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/io.github.cosmic.AppletUnsplash-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        ".cargo",
                        ".flatpak-builder",
                        ".git",
                        ".jj",
                        "builddir",
                        "pkgconfig",
                        "repo",
                        "target"
                    ]
                }
            ]
        }
    ]
}
