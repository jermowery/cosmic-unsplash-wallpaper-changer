<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jermowery.CosmicExtAppletRandomWallpaper</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Random Wallpaper</name>
  <summary>Fetch and configure random desktop wallpapers for the COSMIC™ desktop</summary>
  <description>
    <p>
      A panel applet for the COSMIC™ desktop environment that fetches high-resolution
      random wallpapers (powered by the Unsplash API) and applies them directly to cosmic-bg.
    </p>
    <p>
      Features include configurable API credentials, search queries, topic and collection
      filters, photographer filtering, orientation and safety filters, resolution selection,
      scaling modes, and automatic rotation intervals.
    </p>
  </description>
  <launchable type="desktop-id">io.github.jermowery.CosmicExtAppletRandomWallpaper.desktop</launchable>
  <icon type="stock">io.github.jermowery.CosmicExtAppletRandomWallpaper-symbolic</icon>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-random-wallpaper</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <url type="homepage">https://github.com/jermowery/cosmic-unsplash-wallpaper-changer</url>
  <url type="bugtracker">https://github.com/jermowery/cosmic-unsplash-wallpaper-changer/issues</url>
  <url type="vcs-browser">https://github.com/jermowery/cosmic-unsplash-wallpaper-changer</url>
  <developer id="io.github.jermowery">
    <name>jermowery</name>
  </developer>
  <content_rating type="oars-1.1" />
