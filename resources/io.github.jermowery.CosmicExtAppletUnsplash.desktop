[Desktop Entry]
Name=Unsplash Wallpaper
Comment=Fetch and set wallpapers from Unsplash for the COSMIC™ desktop
Type=Application
Exec=cosmic-ext-applet-unsplash
Terminal=false
Categories=Utility;X-COSMIC;
Keywords=COSMIC;Applet;Wallpaper;Unsplash;Background;
Icon=io.github.jermowery.CosmicExtAppletUnsplash-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
